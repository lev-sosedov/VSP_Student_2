# Copy to .env.production on the host and replace every CHANGE_ME value.
APP_ENV=production
ENVIRONMENT=production
AUTO_CREATE_TABLES=false
DOMAIN=vsp-student.ru
CADDY_EMAIL=ops@example.com
FRONTEND_IMAGE=vsp-frontend:local
POSTGRES_USER=vsp_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=vsp
AUTH_DB_NAME=vsp
USER_DB_NAME=vsp_user
ACADEMIC_DB_NAME=academic_db
SCHEDULE_DB_NAME=schedule_db
CONTENT_DB_NAME=content_db
COMMUNICATION_DB_NAME=communication_db
NOTIFICATION_DB_NAME=notification_db
NEWS_DB_NAME=news_db
RABBITMQ_USERNAME=vsp_app
RABBITMQ_PASSWORD=CHANGE_ME_LONG_RANDOM_RABBITMQ_PASSWORD
RABBITMQ_VIRTUAL_HOST=/
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
JWT_ALGORITHM=RS256
JWT_ISSUER=vsp-auth-service
JWT_AUDIENCE=vsp-student-api
JWT_CLOCK_SKEW_SECONDS=30
JWT_PRIVATE_KEY_HOST_PATH=/opt/vsp/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_HOST_PATH=/opt/vsp/secrets/jwt_public_key.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=https://vsp-student.ru,https://www.vsp-student.ru
FRONTEND_API_URL=
FRONTEND_WS_URL=wss://vsp-student.ru
