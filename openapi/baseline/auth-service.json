{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "description": "Текущий пароль пользователя",
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "description": "Новый пароль пользователя",
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "ChangePasswordResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChangePasswordResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "example": "StrongPassword123",
            "title": "Password",
            "type": "string"
          },
          "phone_number": {
            "example": "+79991234567",
            "title": "Phone Number",
            "type": "string"
          }
        },
        "required": [
          "phone_number",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "description": "Refresh JWT token",
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "password": {
            "description": "Пароль пользователя",
            "example": "Password123",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "phone_number": {
            "description": "Номер телефона пользователя",
            "example": "+79991234567",
            "title": "Phone Number",
            "type": "string"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Имя пользователя",
            "example": "Name",
            "title": "User Name"
          }
        },
        "required": [
          "phone_number",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nAuth Service микросервиса платформы ВШП Студент.\n\nОтвечает за:\n- регистрацию пользователей\n- аутентификацию\n- проверку паролей\n- генерацию JWT токенов\n- обновление access/refresh токенов\n- управление сессиями\n\nНе отвечает за:\n- хранение профиля пользователя\n- роли и права доступа\n- пользовательские данные\n\nUser данные находятся в user-service.\n",
    "title": "VSH Student - Auth Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/change-password": {
      "patch": {
        "description": "Проверяет текущий пароль и сохраняет новый пароль. Пользователь определяется по access token.",
        "operationId": "change_password_api_v1_auth_change_password_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangePasswordResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Текущий пароль неверный или новый пароль совпадает со старым"
          },
          "401": {
            "description": "Недействительный access token"
          },
          "403": {
            "description": "Аккаунт заблокирован"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Изменить пароль текущего пользователя",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Вход пользователя в систему.\n\nПроверяет:\n- номер телефона/email\n- пароль\n\nВозвращает:\n- access token\n- refresh token",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "JWT токены пользователя"
          },
          "401": {
            "description": "Неверный логин или пароль"
          },
          "422": {
            "description": "Ошибка валидации"
          }
        },
        "summary": "Авторизация пользователя",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Завершение сессии.\n\nВ будущем:\n- добавить blacklist JWT\n- удалить refresh token из Redis",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Пользователь вышел"
          }
        },
        "summary": "Выход пользователя",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Получение нового access token.\n\nИспользуется когда:\n- access token истёк\n- refresh token ещё действителен",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Новая пара JWT токенов"
          },
          "401": {
            "description": "Недействительный refresh token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Обновление токена",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Создание нового аккаунта.\n\nПроцесс:\n- проверка данных\n- создание пользователя\n- назначение роли USER\n- выдача токенов\n\nИспользуется:\n- мобильное приложение\n- web клиент",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Register Api V1 Auth Register Post",
                  "type": "object"
                }
              }
            },
            "description": "Результат регистрации"
          },
          "400": {
            "description": "Пользователь уже существует или ошибка данных"
          },
          "422": {
            "description": "Ошибка валидации"
          }
        },
        "summary": "Регистрация пользователя",
        "tags": [
          "Auth"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Используется:\n- Docker healthcheck\n- Kubernetes probe\n- мониторинг",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Проверка состояния сервиса",
        "tags": [
          "System"
        ]
      }
    }
  }
}
