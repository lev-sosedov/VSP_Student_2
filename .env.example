# Copy this file to .env. Never commit the resulting .env file.
COMPOSE_PROJECT_NAME=vsp-student

# PostgreSQL
POSTGRES_USER=vsp_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=vsp
POSTGRES_DEV_PORT=5433

# RabbitMQ
RABBITMQ_USERNAME=vsp_app
RABBITMQ_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_AMQP_DEV_PORT=5672
RABBITMQ_MANAGEMENT_DEV_PORT=15672

# Redis
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
REDIS_DEV_PORT=6379

# JWT is consumed only by auth-service during stage 1.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# Localhost-only development ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8000
USER_SERVICE_PORT=8001
ACADEMIC_SERVICE_PORT=8002
SCHEDULE_SERVICE_PORT=8003
CONTENT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
COMMUNICATION_SERVICE_PORT=8006
NEWS_SERVICE_PORT=8007

# Gateway / browser origins. Production must contain only real HTTPS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Notification email. Leave empty in local development when email is disabled.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=
SMTP_TIMEOUT_SECONDS=20

# Temporary application setting; replace with role-based selection later.
ADMIN_USER_ID=8
