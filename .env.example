# Copy this file to .env. Never commit the resulting .env file.
# PostgreSQL
POSTGRES_USER=vsp_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=vsp
AUTH_DB_NAME=vsp
USER_DB_NAME=vsp_user
ACADEMIC_DB_NAME=academic_db
SCHEDULE_DB_NAME=schedule_db
CONTENT_DB_NAME=content_db
COMMUNICATION_DB_NAME=communication_db
NOTIFICATION_DB_NAME=notification_db
NEWS_DB_NAME=news_db
POSTGRES_DEV_PORT=5433

# RabbitMQ
RABBITMQ_USERNAME=vsp_app
RABBITMQ_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_AMQP_DEV_PORT=5672
RABBITMQ_MANAGEMENT_DEV_PORT=15672
RABBITMQ_USER_RPC_QUEUE=user_service.rpc
RABBITMQ_RPC_TIMEOUT_SECONDS=5

# Redis
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
REDIS_DEV_PORT=6379

# Active configuration for the current HS256 backend.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# Future RS256 cutover settings. Keep commented until auth_service can issue
# the strict RS256 contract and key mounts/secrets have been configured.
# JWT_ALGORITHM=RS256
# JWT_ISSUER=vsp-auth-service
# JWT_AUDIENCE=vsp-student-api
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# JWT_CLOCK_SKEW_SECONDS=30
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# Localhost-only development ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8000
USER_SERVICE_PORT=8001
ACADEMIC_SERVICE_PORT=8002
SCHEDULE_SERVICE_PORT=8003
CONTENT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
COMMUNICATION_SERVICE_PORT=8006
NEWS_SERVICE_PORT=8007

# Gateway / browser origins. Production must contain only real HTTPS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Notification email. Leave empty in local development when email is disabled.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=
SMTP_TIMEOUT_SECONDS=20

# Temporary application setting; replace with role-based selection later.
ADMIN_USER_ID=8
